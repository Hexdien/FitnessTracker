# Common
APP_HOST_PORT=8000
RUN_MIGRATIONS=1
RUN_FOOD_SEED=0
WAIT_FOR_DB=1
DB_WAIT_ATTEMPTS=30
DB_WAIT_DELAY=2

# Production database.
# Use the PostgreSQL service already running on your server.
DATABASE_URL=postgresql://fitness:change-me@postgres-host:5432/fitness

# Development fallback only. Prefer DATABASE_URL when using Docker.
USE_POSTGRES=1
DB_USER=fitness
DB_PASSWORD=change-me
DB_HOST=postgres-host
DB_PORT=5432
DB_NAME=fitness
