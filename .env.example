# Template para producao. Copie como .env.production no servidor.
# Para dev local (SQLite + venv) nao e necessario nenhum .env: os
# defaults em app/config/config.py ja apontam para sqlite:///fitness.db.

APP_HOST_PORT=8000
RUN_MIGRATIONS=1
RUN_FOOD_SEED=0
WAIT_FOR_DB=1
DB_WAIT_ATTEMPTS=30
DB_WAIT_DELAY=2

# PostgreSQL ja existente no servidor (rede local).
DATABASE_URL=postgresql://fitness:change-me@postgres-host:5432/fitness
